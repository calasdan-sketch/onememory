{
  "id": "B09",
  "suite": "contradiction",
  "title": "Overwrite, then distrust the overwriter: the trusted answer comes back",
  "what": "Mallory overwrote the admin's note. The admin distrusts Mallory and restores the earlier version from the note's history; agents then see the trusted value again.",
  "actors": {
    "alice": {
      "scope": "write"
    },
    "mallory": {
      "scope": "write"
    },
    "boss": {
      "scope": "admin"
    }
  },
  "needs": [
    "trust",
    "history"
  ],
  "steps": [
    {
      "op": "write",
      "as": "boss",
      "ref": "n",
      "title": "{{proj}} oncall phone",
      "body": "On-call phone is {{p1}}."
    },
    {
      "op": "update",
      "as": "mallory",
      "ref": "n",
      "body": "On-call phone is {{p2}}."
    },
    {
      "op": "distrust",
      "as": "boss",
      "writer": "mallory"
    },
    {
      "op": "restore_version",
      "as": "boss",
      "ref": "n",
      "version": 1,
      "id": "rv"
    },
    {
      "op": "search",
      "as": "alice",
      "q": "{{proj}} oncall phone",
      "id": "s"
    }
  ],
  "expect": [
    {
      "check": "outcome",
      "step": "rv",
      "is": "ok",
      "desc": "the admin puts the trusted original back"
    },
    {
      "check": "contains_text",
      "step": "s",
      "text": "{{p1}}",
      "desc": "agents see the trusted original value again",
      "metric": "resolution"
    },
    {
      "check": "no_text",
      "step": "s",
      "text": "{{p2}}",
      "desc": "agents do not see the overwriter's value",
      "metric": "resolution"
    }
  ]
}
