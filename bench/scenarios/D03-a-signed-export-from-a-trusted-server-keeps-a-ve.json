{
  "id": "D03",
  "suite": "provenance",
  "title": "A signed export from a trusted server keeps a verified writer",
  "what": "The receiving admin has chosen to trust the sending server's signing key. The original writer is then kept as a verified value and the note is not flagged unverified.",
  "actors": {
    "alice": {
      "scope": "write"
    },
    "boss": {
      "scope": "admin"
    },
    "importer": {
      "scope": "admin",
      "server": "fresh"
    }
  },
  "needs": [
    "export_import",
    "attestation",
    "list"
  ],
  "steps": [
    {
      "op": "write",
      "as": "alice",
      "ref": "n",
      "title": "{{proj}} attested note",
      "body": "Body {{tok}}."
    },
    {
      "op": "export",
      "as": "boss",
      "attest": true,
      "id": "dump"
    },
    {
      "op": "trust_server",
      "as": "importer",
      "of": "main",
      "id": "tr"
    },
    {
      "op": "import",
      "as": "importer",
      "from": "dump",
      "id": "imp"
    },
    {
      "op": "list",
      "as": "importer",
      "id": "l"
    }
  ],
  "expect": [
    {
      "check": "outcome",
      "step": "tr",
      "is": "ok",
      "desc": "trusting the other server works"
    },
    {
      "check": "recoverable",
      "step": "l",
      "value": "alice",
      "desc": "the original writer is kept as a VERIFIED value",
      "title": "{{proj}} attested note",
      "verified_in": [
        "writer",
        "attested_writer"
      ],
      "claim_in": [
        "claimed_writer"
      ],
      "metric": "field"
    },
    {
      "check": "field",
      "step": "l",
      "path": "imported_unverified",
      "desc": "the note is not flagged unverified",
      "title": "{{proj}} attested note",
      "present": false
    }
  ]
}
