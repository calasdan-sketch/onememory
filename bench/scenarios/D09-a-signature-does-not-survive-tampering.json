{
  "id": "D09",
  "suite": "provenance",
  "title": "A signature does not survive tampering",
  "what": "A signed export is altered in transit (the body is changed). The receiving server trusts the sender's key, yet it must not vouch for the altered note: the writer drops to an unverified claim.",
  "actors": {
    "alice": {
      "scope": "write"
    },
    "boss": {
      "scope": "admin"
    },
    "importer": {
      "scope": "admin",
      "server": "fresh"
    }
  },
  "needs": [
    "export_import",
    "attestation",
    "list"
  ],
  "steps": [
    {
      "op": "write",
      "as": "alice",
      "ref": "n",
      "title": "{{proj}} tamper note",
      "body": "Original body {{tok}}."
    },
    {
      "op": "export",
      "as": "boss",
      "attest": true,
      "id": "dump"
    },
    {
      "op": "trust_server",
      "as": "importer",
      "of": "main"
    },
    {
      "op": "import",
      "as": "importer",
      "from": "dump",
      "id": "imp",
      "tamper": {
        "field": "body",
        "value": "Changed body"
      }
    },
    {
      "op": "list",
      "as": "importer",
      "id": "l"
    }
  ],
  "expect": [
    {
      "check": "field",
      "step": "l",
      "path": "attested_writer",
      "desc": "no verified author on the altered note",
      "title": "{{proj}} tamper note",
      "present": false,
      "metric": "field"
    },
    {
      "check": "field",
      "step": "l",
      "path": "imported_unverified",
      "desc": "flagged unverified",
      "title": "{{proj}} tamper note",
      "equals": true,
      "metric": "field"
    }
  ]
}
