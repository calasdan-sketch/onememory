{
  "id": "D13",
  "suite": "provenance",
  "title": "A swept note keeps its provenance in the archive",
  "what": "A note past its deadline is swept. The archived copy still names its writer and creation time.",
  "actors": {
    "alice": {
      "scope": "write"
    },
    "boss": {
      "scope": "admin"
    }
  },
  "needs": [
    "restore",
    "retire",
    "list"
  ],
  "steps": [
    {
      "op": "write",
      "as": "boss",
      "ref": "n",
      "title": "{{proj}} swept note",
      "body": "Body {{tok}}.",
      "expires_in_days": -1,
      "id": "w"
    },
    {
      "op": "sweep",
      "as": "boss",
      "id": "sw"
    },
    {
      "op": "list",
      "as": "boss",
      "id": "arch",
      "include_archived": true
    }
  ],
  "expect": [
    {
      "check": "field",
      "step": "arch",
      "path": "writer",
      "desc": "writer still named",
      "title": "{{proj}} swept note",
      "equals": "boss",
      "metric": "field"
    },
    {
      "check": "field",
      "step": "arch",
      "path": "created_at",
      "desc": "created_at still there",
      "title": "{{proj}} swept note",
      "present": true,
      "metric": "field"
    },
    {
      "check": "field",
      "step": "arch",
      "path": "expires_at",
      "desc": "deadline still there",
      "title": "{{proj}} swept note",
      "present": true,
      "metric": "field"
    }
  ]
}
