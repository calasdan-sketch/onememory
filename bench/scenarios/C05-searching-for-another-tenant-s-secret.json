{
  "id": "C05",
  "suite": "isolation",
  "title": "Searching for another tenant's secret",
  "what": "Tenant B searches for words only tenant A's note has, with and without naming tenantA as the namespace.",
  "actors": {
    "a1": {
      "scope": "write",
      "namespace": "tenantA",
      "writer": "agentA"
    },
    "b1": {
      "scope": "write",
      "namespace": "tenantB",
      "writer": "agentB"
    }
  },
  "steps": [
    {
      "op": "write",
      "as": "a1",
      "ref": "n",
      "title": "{{proj}} roadmap",
      "body": "Roadmap {{canA}}."
    },
    {
      "op": "search",
      "as": "b1",
      "q": "{{canA}}",
      "id": "plain"
    },
    {
      "op": "search",
      "as": "b1",
      "q": "{{canA}}",
      "id": "hinted",
      "namespace": "tenantA"
    },
    {
      "op": "search",
      "as": "a1",
      "q": "{{canA}}",
      "id": "own"
    }
  ],
  "expect": [
    {
      "check": "hit_count",
      "step": "plain",
      "desc": "no result for tenant B",
      "is": 0,
      "metric": "leak"
    },
    {
      "check": "hit_count",
      "step": "hinted",
      "desc": "no result even when tenant B names tenantA",
      "is": 0,
      "metric": "leak"
    },
    {
      "check": "no_text",
      "step": "hinted",
      "text": "{{canA}}",
      "desc": "the secret is not in the answer",
      "metric": "leak"
    },
    {
      "check": "has",
      "step": "own",
      "ref": "n",
      "desc": "tenant A finds its own note",
      "metric": "unexpected_denial"
    }
  ]
}
